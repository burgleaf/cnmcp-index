{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CNMCP AI Candidate Review Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "repository",
    "kind",
    "summaryZh",
    "targetUsers",
    "useCases",
    "license",
    "maintenance",
    "compatibility",
    "risks",
    "missingInformation",
    "recommendation",
    "recommendationReason"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "pattern": "^github:[a-z0-9_.-]+/[a-z0-9_.-]+$", "maxLength": 180 },
    "repository": { "$ref": "#/$defs/httpsUrl" },
    "kind": { "$ref": "#/$defs/factKind" },
    "summaryZh": { "type": "string", "minLength": 10, "maxLength": 300 },
    "targetUsers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 100 }
    },
    "useCases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/factText" }
    },
    "license": { "$ref": "#/$defs/factText" },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis", "evidenceUrl", "note"],
      "properties": {
        "status": { "enum": ["active", "inactive", "archived", "unknown"] },
        "basis": { "$ref": "#/$defs/basis" },
        "evidenceUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
        "note": { "type": "string", "minLength": 2, "maxLength": 240 }
      }
    },
    "compatibility": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "status", "basis", "evidenceUrl", "note"],
        "properties": {
          "platform": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
          "status": { "enum": ["native", "supported", "partial", "unsupported", "unknown"] },
          "basis": { "$ref": "#/$defs/basis" },
          "evidenceUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
          "note": { "type": "string", "minLength": 2, "maxLength": 240 }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "title", "basis", "evidenceUrl"],
        "properties": {
          "level": { "enum": ["low", "medium", "high"] },
          "title": { "type": "string", "minLength": 2, "maxLength": 160 },
          "basis": { "$ref": "#/$defs/basis" },
          "evidenceUrl": { "$ref": "#/$defs/nullableHttpsUrl" }
        }
      }
    },
    "missingInformation": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 160 }
    },
    "recommendation": { "enum": ["draft_pr", "needs_human", "do_not_list"] },
    "recommendationReason": { "type": "string", "minLength": 5, "maxLength": 400 }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048 },
    "nullableHttpsUrl": { "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
    "basis": { "enum": ["github_api", "upstream", "ai_summary", "unknown"] },
    "factText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis", "evidenceUrl"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 300 },
        "basis": { "$ref": "#/$defs/basis" },
        "evidenceUrl": { "$ref": "#/$defs/nullableHttpsUrl" }
      }
    },
    "factKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis", "evidenceUrl"],
      "properties": {
        "value": { "enum": ["mcp", "skill", "plugin", "unknown"] },
        "basis": { "$ref": "#/$defs/basis" },
        "evidenceUrl": { "$ref": "#/$defs/nullableHttpsUrl" }
      }
    }
  }
}
