{
  "name": "cnmcp-stats-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-24",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://www.cnmcp.com",
    "EVENT_RATE_LIMIT_PER_HOUR": "120",
    "RECEIPT_RETENTION_SECONDS": "691200",
    "RATE_LIMIT_RETENTION_SECONDS": "7200",
    "TASK_QUERY_RETENTION_SECONDS": "2592000",
    "GAP_QUALIFY_MIN_SEARCHES": "3",
    "GAP_QUALIFY_MIN_SCORE": "50"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cnmcp-stats",
      "database_id": "e3d9d36b-9c6f-4618-8180-1ea57f6fe49c",
      "migrations_dir": "migrations"
    }
  ]
}
