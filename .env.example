# 仅允许公开的浏览器构建配置；不要在 NEXT_PUBLIC_* 中放置任何 Worker secret。
NEXT_PUBLIC_SITE_URL=https://www.cnmcp.com
NEXT_PUBLIC_STATS_API_URL=https://api.cnmcp.com
# 可选；未配置时投稿页不会猜测仓库地址或生成误导外链。
NEXT_PUBLIC_GITHUB_REPOSITORY_URL=https://github.com/owner/repository
# 可选的 Cloudflare Web Analytics 公开站点 token；不是 API token/secret，缺失时不加载 beacon。
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=0123456789abcdef0123456789abcdef
