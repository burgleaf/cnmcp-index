        {
          "type": "config",
          "label": "Claude Code 配置",
          "content": "{\"endpoint\":\"{{SERVICE_URL}}\"}",
          "target": "~/.claude/settings.json",
          "placeholders": [
            {
              "name": "SERVICE_URL",
              "description": "测试服务地址",
              "secret": false
            }
          ]
        }
      ]
